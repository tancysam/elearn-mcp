# Authentication browser: edge (default) or chrome
ELEARN_BROWSER=edge
ELEARN_BASE_URL=https://elearn.smu.edu.sg
ELEARN_LP_VERSION=1.49
ELEARN_LE_VERSION=1.49
ELEARN_COURSE_ORG_UNIT_TYPE_ID=3
# ELEARN_PROFILE_DIR=/absolute/path/to/a/dedicated/browser-profile
# ELEARN_AUTH_STATE_FILE=/absolute/path/to/storage-state.json
# ELEARN_AUTH_INITIAL_WAIT_SECONDS=60
# ELEARN_AUTH_POLL_INTERVAL_SECONDS=15
# ELEARN_AUTH_TIMEOUT_SECONDS=300
# ELEARN_DOWNLOAD_DIR=/absolute/path/to/downloads
# ELEARN_HEADLESS=true
