{
  "mcpServers": {
    "smu-elearn": {
      "title": "SMU eLearn",
      "description": "Read-only access to courses, pinned courses, weekly modules, and documents in SMU eLearn.",
      "cwd": ".",
      "command": "node",
      "args": [
        "./mcp/dist/src/server.js"
      ],
      "env_vars": [
        "HOME",
        "PATH",
        "ELEARN_BASE_URL",
        "ELEARN_LP_VERSION",
        "ELEARN_LE_VERSION",
        "ELEARN_COURSE_ORG_UNIT_TYPE_ID",
        "ELEARN_PROFILE_DIR",
        "ELEARN_AUTH_STATE_FILE",
        "ELEARN_AUTH_INITIAL_WAIT_SECONDS",
        "ELEARN_AUTH_POLL_INTERVAL_SECONDS",
        "ELEARN_AUTH_TIMEOUT_SECONDS",
        "ELEARN_DOWNLOAD_DIR",
        "ELEARN_HEADLESS",
        "ELEARN_BROWSER"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 420
    }
  }
}
